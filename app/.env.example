# Copy to .env.local and fill in values. Never commit .env.local.

# ─── Database (Supabase) ────────────────────────────────────────────────────
# Pooled connection (port 6543, transaction mode) for app runtime
DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres
# Direct connection (port 5432) for drizzle-kit migrations
DATABASE_URL_DIRECT=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Inngest ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Ingestion config ───────────────────────────────────────────────────────
# How many months back to fetch on first run (seed mode)
INGESTION_SEED_MONTHS=6
# arXiv API max_results per query (1000 is arXiv's hard cap; we page under it)
INGESTION_ARXIV_MAX_RESULTS=500

# Optional — free key from semanticscholar.org/product/api boosts rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional in dev — when set, POST /api/ingest/* requires header
#   x-ingest-secret: <value>
# Required in production (enforced at boot in A8).
INGEST_TRIGGER_SECRET=

# ─── Phase B only ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
INGESTION_DAILY_LLM_TOKEN_BUDGET=100000
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── App config ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
