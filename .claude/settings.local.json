{
  "permissions": {
    "allow": [
      "Bash(/bin/ls *)",
      "Bash(/usr/bin/find *)",
      "Bash(/bin/rm *)",
      "Bash(/usr/local/bin/node --version)",
      "Bash(/opt/homebrew/bin/node --version)",
      "Read(//usr/local/bin/**)",
      "Bash(/usr/bin/xargs -I {} /usr/bin/basename {})",
      "Bash(/usr/bin/head -10)",
      "Bash(/bin/sleep 8)",
      "Bash(/usr/bin/tail -40)",
      "Bash(export PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\")",
      "Bash(grep -E \"^\\(node|pnpm|npm|npx\\)$\")"
    ]
  }
}
